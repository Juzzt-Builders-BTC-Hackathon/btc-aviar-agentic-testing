OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Local single-user service. Do not expose it to a network.
QA_PORT=8765
QA_DATA_DIR=data
QA_BROWSER_CHANNEL=chromium
# Optional writable browser temporary directory; defaults to data/runtime/browser-temp.
QA_BROWSER_TEMP_DIR=
# * accepts any HTTP(S) target. Alternatively use comma-separated exact origins.
# Each browser run stays on its selected target origin.
QA_ALLOWED_ORIGINS=*
# Optional Playwright storage state JSON for an authenticated staging session.
QA_STORAGE_STATE=
# Scope authentication to this exact origin. Leave blank for public apps.
TARGET_AUTH_ORIGIN=https://www.saucedemo.com
TARGET_USERNAME=
TARGET_PASSWORD=
TARGET_LOGIN_PATH=/
TARGET_USERNAME_SELECTOR=[data-test="username"]
TARGET_PASSWORD_SELECTOR=[data-test="password"]
TARGET_SUBMIT_SELECTOR=[data-test="login-button"]
TARGET_SUCCESS_SELECTOR=[data-test="inventory-container"]
# Optional rates per million tokens; blank means cost is not estimated.
OPENAI_INPUT_PRICE=
OPENAI_OUTPUT_PRICE=
# V1 remains the default until V2 is explicitly selected.
QA_PIPELINE_VERSION=v1
QA_V2_CHECKPOINT_DB=data/langgraph-v2.sqlite3
QA_V2_MAX_LLM_CALLS=8
